BAHAR_DATABASE_URL=postgresql+psycopg://bahar_app:change-me@postgres:5432/bahar
BAHAR_DATABASE_ADMIN_URL=postgresql+psycopg://bahar_migrator:change-me@postgres:5432/bahar
BAHAR_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
BAHAR_PRINCIPAL_ID=00000000-0000-4000-8000-000000000001
BAHAR_OBJECT_ENDPOINT=http://minio:9000
BAHAR_OBJECT_REGION=us-east-1
BAHAR_OBJECT_ACCESS_KEY=bahar
BAHAR_OBJECT_SECRET_KEY=change-me
BAHAR_OBJECT_KMS_KEY_ID=alias/bahar-production
BAHAR_OBJECT_ENCRYPTION_MODE=aws-kms
BAHAR_OBJECT_CLIENT_KEY=
BAHAR_OBJECT_BUCKET_QUARANTINE=bahar-quarantine
BAHAR_OBJECT_BUCKET_GOVERNED=bahar-governed
BAHAR_OBJECT_BUCKET_DERIVED=bahar-derived
BAHAR_OBJECT_BUCKET_EXPORTS=bahar-exports
BAHAR_OBJECT_BUCKET_AUDIT=bahar-audit
BAHAR_AUDIT_HMAC_KEY=replace-with-32-or-more-random-bytes
BAHAR_CLAMD_HOST=clamav
BAHAR_CLAMD_PORT=3310
BAHAR_TESSERACT_LANGUAGES=aze+eng+rus
BAHAR_MAX_UPLOAD_BYTES=104857600
BAHAR_MAX_PAGES=1000
BAHAR_MAX_EXPANDED_BYTES=524288000
BAHAR_MAX_EXPANSION_RATIO=100

# F49–F56: Configure a trusted external OIDC identity provider for production.
# API audience must differ from the SPA client ID. Redirect and other URLs
# MUST use HTTPS; configure a public HTTPS reverse proxy onto 127.0.0.1:8088.
BAHAR_OIDC_ISSUER=https://sso.example.com/realms/bahar
BAHAR_OIDC_AUDIENCE=bahar-api
BAHAR_OIDC_JWKS_URL=https://sso.example.com/realms/bahar/protocol/openid-connect/certs
BAHAR_OIDC_CLIENT_ID=bahar-spa-public
BAHAR_OIDC_AUTHORIZE_URL=https://sso.example.com/realms/bahar/protocol/openid-connect/auth
BAHAR_OIDC_TOKEN_URL=https://sso.example.com/realms/bahar/protocol/openid-connect/token
BAHAR_OIDC_REDIRECT_URI=https://bahar.example.com/
# Comma-separated approved provider ACR values that represent MFA;
# 'mfa'/'otp'/'hwk' in verified amr also qualify.
BAHAR_OIDC_MFA_ACR=urn:example:mfa
BAHAR_OIDC_FRESH_AUTH_SECONDS=300

# Only use for a private container whose exposed Docker port is mapped to
# host loopback; this is not a substitute for an external TLS reverse proxy.
# BAHAR_ALLOW_CONTAINER_BIND=1
